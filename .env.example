# Copy this file to .env and fill real values. NEVER commit real secrets.

# ===== Azure SQL =====
AZURE_SQL_SERVER=your_server.database.windows.net
AZURE_SQL_DATABASE=your_database
AZURE_SQL_USERNAME=your_user
AZURE_SQL_PASSWORD=your_password
AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}

# ===== Azure Event Hub =====
EVENT_HUB_CONNECTION_STRING=Endpoint=sb://xxx.servicebus.windows.net/;SharedAccessKeyName=xxx;SharedAccessKey=xxx=;EntityPath=eventhub1
EVENT_HUB_NAME=eventhub1

# ===== Yelp API =====
YELP_API_KEY=your_yelp_api_key
YELP_ENDPOINT=https://api.yelp.com/v3/businesses/search

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=yelp_business_data
INGEST_LOCATIONS=New York,Los Angeles,Chicago,Houston,Phoenix
POLL_INTERVAL_SEC=60
REQUEST_TIMEOUT=20
MAX_RETRIES=3
BACKOFF_SEC=5

# ===== Model Artifacts =====
MODEL_PATH=recommendation_model.pkl
VECTORIZER_PATH=tfidf_vectorizer.pkl

# ===== Data Paths (relative) =====
BRONZE_BUSINESS_PATH=./data/bronze/yelp_academic_dataset_business.json
SILVER_BUSINESS_PATH=./data/silver/business
